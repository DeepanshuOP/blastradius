.env
data/*
corpus/
/logs/
worktrees/
# The generated tables and figures are tracked (data: snapshot commits); anything else a script
# leaves in the directory stays ignored.
paper/generated/*
!paper/generated/*.md
!paper/generated/*.pdf
__pycache__/
.venv/
*.parquet
# Checked-in test fixtures are real row slices and must ship with the repo.
!tests/fixtures/**/*.parquet
*.jsonl.gz
.pytest_cache/
.ruff_cache/

!data/frame/
!data/frame/**
.env*
!.env.example
data/frame/repos.partial.csv
.claude/
graphify-out/

# Build output of analysis/build_release.py. Only *.parquet was ignored before,
# which left CANARY.txt and CHECKSUMS.sha256 committable; the bundle carries
# pseudonymised author data and regenerates from data/interim, so none of it
# belongs in git.
/release/

# demo-web (Next.js)
demo-web/node_modules
demo-web/.next
demo-web/next-env.d.ts
demo-web/tsconfig.tsbuildinfo
